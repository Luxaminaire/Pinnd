noteArray = [ ];

#Add notes to an array of notes. Used for tracking and layerLevels
#layerLevel will be related to order in array, prevent orderLevel from being ==

def addToNoteArray(noteID) {
	noteArray.append(noteID)
}

def textNoteCreator() {
	create text note object with defaut values, including spawn location
	Generate a noteID
	addToNoteArray(this)
}

def imageCreator() {
	create image note object ready to receive image and default size values
	generate a noteID
	addToNoteArray(this)
}

def soundNoteCreator() {
	create sound note object with default values
	generate a noteID
	addToNoteArray(this)
}

